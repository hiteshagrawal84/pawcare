NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pawcare
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:3010,http://localhost:3000

# S3-compatible storage (MinIO locally / AWS S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=pawcare
S3_SECRET_KEY=pawcaresecret
S3_BUCKET=pawcare
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
